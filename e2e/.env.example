TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/ticket_management_test?schema=public"
SERVER_PORT=3002
CLIENT_PORT=4300

# Shared secret the e2e-spawned server is started with (overridden in playwright.config.ts's
# webServer env, same as DATABASE_URL/PORT/CLIENT_URL) so inbound-email.spec.ts can present a
# known Authorization: Bearer value — deliberately not whatever real secret server/.env has,
# since this is a fixed test-only value.
INBOUND_EMAIL_WEBHOOK_SECRET=e2e-inbound-email-webhook-secret

# Fixed, idempotent test-DB-only accounts seeded by setup-test-db.ts / seed-test-users.ts.
# These are throwaway credentials that only ever exist in ticket_management_test — not real
# secrets, never used against the dev database.
E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=E2eAdminPass123!
E2E_AGENT_EMAIL=e2e-agent@example.com
E2E_AGENT_PASSWORD=E2eAgentPass123!
